# NewsPress Wire Ingestion Worker Environment (Google Compute Engine e2-micro)
# Copy this file to /etc/newspress-wire-worker.env on the VM and set chmod 640 (root:newspress).

# ---------------------------------------------------------------------------
# Free-Tier Multi-Project API Key Pool (4 independent GCP / AI Studio projects)
# Requests rotate round-robin across all configured keys with automatic 429
# per-(key, model) cooldown and failover. Leave unused slots blank.
# ---------------------------------------------------------------------------
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# Optional alternative: comma-separated list or legacy single key
# GEMINI_API_KEYS=
# GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Free-Tier High-Quota Light Model Priority Chain (comma-separated)
# Primary : gemini-3.1-flash-lite (lightest, highest free-tier quota, minimal thinking)
# Fallback: gemini-4-hydrogen     (fast free-tier flash fallback with low thinking)
# ---------------------------------------------------------------------------
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-4-hydrogen

# Per-key RPM protection & cooldown tuning (tuned for 4 free-tier project keys)
# 4000ms per key x 4 keys => ~1 story/sec combined while keeping each key <= 15 RPM
GEMINI_MIN_KEY_INTERVAL_MS=4000
GEMINI_RPM_COOLDOWN_MS=65000
GEMINI_DAILY_COOLDOWN_MS=1800000
REWRITER_MAX_INPUT_CHARS=7500

# Target Firebase project & named Firestore database
FIREBASE_PROJECT_ID=alfa-news-service-test-project
FIRESTORE_DATABASE_ID=ai-studio-9028c422-4dc9-4d54-bb36-aecf77ecd094

# Optional: Only needed for local testing outside GCE (on GCE, attach a Service Account instead)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Worker identity & scheduling (tuned for e2-micro 1 GB RAM)
WORKER_ID=gce-e2-micro-primary
WORKER_REGION=us-central1
LOOP_INTERVAL_SECONDS=120
MAX_CONCURRENT_SOURCES=2
FETCH_TIMEOUT_MS=15000
MAX_RESPONSE_BYTES=3145728
