    // --- Phase 9: Edition Content Reservations ---
    match /editionContentReservations/{reservationId} {
      allow get, list: if isSignedIn() && (
        isPlatformAdmin() ||
        isTenantMember(resource.data.tenantId)
      );
      allow create, update: if isSignedIn() && isValidId(reservationId) && (
        isPlatformAdmin() ||
        isTenantEditor(request.resource.data.tenantId)
      );
      allow delete: if isPlatformAdmin() || isTenantAdmin(resource.data.tenantId);
    }

    // --- Phase 9: Edition Advertisement Reservations ---
    match /editionAdvertisementReservations/{reservationId} {
      allow get, list: if isSignedIn() && (
        isPlatformAdmin() ||
        isTenantMember(resource.data.tenantId)
      );
      allow create, update: if isSignedIn() && isValidId(reservationId) && (
        isPlatformAdmin() ||
        isTenantEditor(request.resource.data.tenantId)
      );
      allow delete: if isPlatformAdmin() || isTenantAdmin(resource.data.tenantId);
    }

    // --- Phase 9: Edition Page Plans ---
    match /editionPagePlans/{pagePlanId} {
      allow get, list: if isSignedIn() && (
        isPlatformAdmin() ||
        isTenantMember(resource.data.tenantId)
      );
      allow create, update: if isSignedIn() && isValidId(pagePlanId) && (
        isPlatformAdmin() ||
        isTenantEditor(request.resource.data.tenantId)
      );
      allow delete: if isPlatformAdmin();
    }

    // --- Phase 9: Edition Content Versions (Immutable) ---
    match /editionContentVersions/{versionId} {
      allow get, list: if isSignedIn() && (
        isPlatformAdmin() ||
        isTenantMember(resource.data.tenantId)
      );
      allow create: if isSignedIn() && isValidId(versionId) && (
        isPlatformAdmin() ||
        isTenantEditor(request.resource.data.tenantId)
      );
      allow update: if false; // Immutable historical versions
      allow delete: if false; // Immutable historical versions
    }

    // --- Phase 10: Print Vendors ---
    match /printVendors/{vendorId} {
      allow get, list: if isSignedIn() && (
        isPlatformAdmin() ||
        isTenantMember(resource.data.tenantId)
      );
      allow create, update: if isSignedIn() && isValidId(vendorId) && (
        isPlatformAdmin() ||
        isTenantAdmin(request.resource.data.tenantId)
      );
      allow delete: if isPlatformAdmin() || isTenantAdmin(resource.data.tenantId);
    }

    // --- Phase 10: Print Vendor Capabilities ---
    match /printVendorCapabilities/{vendorId} {
      allow get, list: if isSignedIn() && (
