        isTenantMember(resource.data.tenantId)
      );
      allow create, update: if isSignedIn() && isValidId(vendorId) && (
        isPlatformAdmin() ||
        isTenantAdmin(request.resource.data.tenantId)
      );
      allow delete: if isPlatformAdmin() || isTenantAdmin(resource.data.tenantId);
    }

    // --- Phase 10: Production Regions ---
    match /productionRegions/{regionId} {
      allow get, list: if isSignedIn() && (
        isPlatformAdmin() ||
        isTenantMember(resource.data.tenantId)
      );
      allow create, update: if isSignedIn() && isValidId(regionId) && (
        isPlatformAdmin() ||
        isTenantAdmin(request.resource.data.tenantId)
      );
      allow delete: if isPlatformAdmin() || isTenantAdmin(resource.data.tenantId);
    }

    // --- Phase 10: Print Production Artifacts (Cryptographic Sealed & Immutable) ---
    match /printProductionArtifacts/{artifactId} {
      allow get, list: if isSignedIn() && (
        isPlatformAdmin() ||
        isTenantMember(resource.data.tenantId)
      );
      allow create: if isSignedIn() && isValidId(artifactId) && (
        isPlatformAdmin() ||
        isTenantAdmin(request.resource.data.tenantId) ||
        isTenantEditor(request.resource.data.tenantId)
      );
      // Artifacts are strictly immutable once generated; corrections create new versions
      allow update: if isSignedIn() && (
        isPlatformAdmin() ||
        isTenantAdmin(resource.data.tenantId)
      );
      allow delete: if isPlatformAdmin();
    }

    // --- Phase 10: Print Vendor Dispatches ---
    match /printVendorDispatches/{dispatchId} {
      allow get, list: if isSignedIn() && (
        isPlatformAdmin() ||
        isTenantMember(resource.data.tenantId)
      );
      allow create, update: if isSignedIn() && isValidId(dispatchId) && (
        isPlatformAdmin() ||
        isTenantAdmin(request.resource.data.tenantId) ||
        isTenantEditor(request.resource.data.tenantId)
      );
      allow delete: if isPlatformAdmin();
    }

    // --- Phase 10: Vendor Proofs ---
    match /vendorProofs/{proofId} {
      allow get, list: if isSignedIn() && (
        isPlatformAdmin() ||
        isTenantMember(resource.data.tenantId)
      );
      allow create, update: if isSignedIn() && isValidId(proofId) && (
        isPlatformAdmin() ||
        isTenantEditor(request.resource.data.tenantId)
      );
      allow delete: if isPlatformAdmin();
    }

    // --- Phase 10: Print Distributions & Delivery ---
    match /printDistributions/{distributionId} {
      allow get, list: if isSignedIn() && (
        isPlatformAdmin() ||
        isTenantMember(resource.data.tenantId)
      );
      allow create, update: if isSignedIn() && isValidId(distributionId) && (
        isPlatformAdmin() ||
        isTenantEditor(request.resource.data.tenantId) ||
        isTenantAdmin(request.resource.data.tenantId)
      );
      allow delete: if isPlatformAdmin();
    }

    // --- Phase 11: Revenue Events ---
    match /revenueEvents/{eventId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isPlatformAdmin();
    }

    // --- Phase 11: Revenue Split Snapshots ---
    match /revenueSplitSnapshots/{snapshotId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isPlatformAdmin();
    }

    // --- Phase 11: Financial Ledger ---
    match /financialLedger/{ledgerId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isPlatformAdmin();
    }

    // --- Phase 11: Payout Profiles ---
    match /payoutProfiles/{profileId} {
      allow get: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isPlatformAdmin());
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && (request.resource.data.ownerId == request.auth.uid || isPlatformAdmin());
      allow delete: if isPlatformAdmin();
    }

    // --- Phase 11: Payout Requests ---
    match /payoutRequests/{requestId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (request.resource.data.requestedBy == request.auth.uid || request.resource.data.ownerId == request.auth.uid || isPlatformAdmin());
      allow update: if isSignedIn();
      allow delete: if isPlatformAdmin();
    }

    // --- Phase 11: Payout Reservations ---
    match /payoutReservations/{reservationId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isPlatformAdmin();
    }

    // --- Phase 11: Financial Audit Events ---
    match /financialAuditEvents/{auditId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit log
    }

    // --- Phase 14: Saved Analytics Reports ---
    match /savedAnalyticsReports/{reportId} {
      allow get, list: if isSignedIn() && (isPlatformAdmin() || isTenantMember(resource.data.tenantId));
      allow create: if isSignedIn() && (isPlatformAdmin() || isTenantAdmin(request.resource.data.tenantId));
      allow update: if isSignedIn() && (isPlatformAdmin() || isTenantAdmin(resource.data.tenantId));
      allow delete: if isSignedIn() && (isPlatformAdmin() || isTenantAdmin(resource.data.tenantId));
    }

    // --- Phase 14: Analytics Report Snapshots ---
    match /analyticsReportSnapshots/{snapshotId} {
      allow get, list: if isSignedIn() && (isPlatformAdmin() || isTenantMember(resource.data.tenantId));
      allow create: if isSignedIn() && (isPlatformAdmin() || isTenantAdmin(request.resource.data.tenantId));
      allow update, delete: if false; // Immutable snapshot
    }

    // --- Phase 14: Analytics Alerts ---
    match /analyticsAlerts/{alertId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isPlatformAdmin() || isTenantAdmin(resource.data.tenantId));
      allow delete: if isPlatformAdmin();
    }

    // --- Phase 14: Daily & Monthly Aggregations ---
    match /analyticsDaily/{aggregationId} {
      allow get, list: if isSignedIn();
      allow create, update: if isPlatformAdmin();
      allow delete: if isPlatformAdmin();
    }

    match /analyticsMonthly/{aggregationId} {
      allow get, list: if isSignedIn();
      allow create, update: if isPlatformAdmin();
      allow delete: if isPlatformAdmin();
    }

    // --- Phase 15: API Applications & Integrations ---
    match /apiApplications/{appId} {
      allow get, list: if isSignedIn() && (isPlatformAdmin() || isTenantMember(resource.data.tenantId));
      allow create: if isSignedIn() && (isPlatformAdmin() || isTenantAdmin(request.resource.data.tenantId));
      allow update, delete: if isSignedIn() && (isPlatformAdmin() || isTenantAdmin(resource.data.tenantId));
    }

    // --- Phase 15: API Credentials & Verifiers ---
    match /apiCredentials/{keyId} {
      allow get, list: if isSignedIn() && (isPlatformAdmin() || isTenantAdmin(resource.data.tenantId));
      allow create: if isSignedIn() && (isPlatformAdmin() || isTenantAdmin(request.resource.data.tenantId));
      allow update, delete: if isSignedIn() && (isPlatformAdmin() || isTenantAdmin(resource.data.tenantId));
    }

    // --- Phase 15: API Usage & Metering Records ---
    match /apiUsageRecords/{recordId} {
      allow get, list: if isSignedIn() && (isPlatformAdmin() || isTenantMember(resource.data.tenantId));
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable telemetry log
    }

    // --- Phase 15: API Idempotency Records ---
    match /apiIdempotencyRecords/{recordId} {
      allow get, list, create: if isSignedIn();
      allow update, delete: if isPlatformAdmin();
    }

    // --- Phase 15: Webhook Endpoints ---
    match /webhookEndpoints/{endpointId} {
      allow get, list: if isSignedIn() && (isPlatformAdmin() || isTenantMember(resource.data.tenantId));
      allow create: if isSignedIn() && (isPlatformAdmin() || isTenantAdmin(request.resource.data.tenantId));
      allow update, delete: if isSignedIn() && (isPlatformAdmin() || isTenantAdmin(resource.data.tenantId));
    }

    // --- Phase 15: Webhook Events ---
    match /webhookEvents/{eventId} {
      allow get, list: if isSignedIn() && (isPlatformAdmin() || isTenantMember(resource.data.tenantId));
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable event record
    }

    // --- Phase 15: Webhook Deliveries ---
    match /webhookDeliveries/{deliveryId} {
      allow get, list: if isSignedIn() && (isPlatformAdmin() || isTenantMember(resource.data.tenantId));
      allow create, update: if isSignedIn();
      allow delete: if isPlatformAdmin();
    }

    // --- Phase 15: API Audit Events ---
    match /apiAuditEvents/{eventId} {
      allow get, list: if isSignedIn() && (isPlatformAdmin() || isTenantMember(resource.data.tenantId));
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit log
    }

    // --- Phase 17: Platform Configuration Management ---
    match /platformConfigs/{configId} {
      allow get, list: if isSignedIn() && isPlatformAdmin();
      allow create, update, delete: if isPlatformAdmin();
    }

    // --- Phase 17: Publisher Onboarding & Tenant Lifecycle ---
    match /publisherOnboardings/{tenantId} {
      allow get, list: if isSignedIn() && (isPlatformAdmin() || isTenantMember(tenantId));
      allow create, update: if isSignedIn() && (isPlatformAdmin() || isTenantAdmin(tenantId));
      allow delete: if isPlatformAdmin();
    }

    // --- Phase 17: Support & Customer Operations ---
    match /supportCases/{caseId} {
      allow get, list: if isSignedIn() && (isPlatformAdmin() || isTenantMember(resource.data.tenantId));
      allow create: if isSignedIn() && (isPlatformAdmin() || isTenantMember(request.resource.data.tenantId));
      allow update: if isSignedIn() && (isPlatformAdmin() || isTenantMember(resource.data.tenantId));
      allow delete: if isPlatformAdmin();
    }

    // --- Phase 17: Legal & Policy Documents ---
    match /policyDocuments/{docId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isPlatformAdmin();
    }

    // --- Phase 17: Policy Acceptances ---
    match /policyAcceptances/{acceptanceId} {
      allow get, list: if isSignedIn() && (isPlatformAdmin() || isTenantMember(resource.data.tenantId));
      allow create: if isSignedIn() && (isPlatformAdmin() || isTenantMember(request.resource.data.tenantId));
      allow update, delete: if isPlatformAdmin();
    }

    // --- Phase 17: Launch Readiness Gates ---
    match /launchReadinessChecks/{checkId} {
      allow get, list: if isSignedIn() && isPlatformAdmin();
      allow create, update, delete: if isPlatformAdmin();
    }
  }
}

